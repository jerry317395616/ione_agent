{
  "manifest_version": 3,
  "name": "童健云智能助手",
  "version": "2.1.4",
  "description": "在 2.1.3 基础上精确隐藏侧边栏“社区”和“Coder”入口，不隐藏父容器或其它侧边栏项。",
  "content_scripts": [
    {
      "matches": [
        "https://chat.qwen.ai/*"
      ],
      "css": [
        "content.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
