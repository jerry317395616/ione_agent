IONE_CODEX_BRIDGE_TOKEN=replace-with-random-long-token
IONE_AGENT_RUNTIME=codex
IONE_MODEL_API_KEY=replace-with-internal-qwen-gateway-key
IONE_MODEL_API_BASE=http://10.144.133.1:1234
IONE_MODEL_REQUIRE_PRIVATE_NETWORK=1
IONE_CODEX_MODEL=qwen3.6-35b-a3b-fp8
IONE_CODEX_MODEL_PROVIDER=qwen-local
IONE_CODEX_MODEL_CONTEXT_WINDOW=262144
# Legacy browser runtime stays disabled. Codex App Server is the only production runtime.
IONE_ORACLE_BROWSER_ENABLED=0
IONE_ORACLE_BROWSER_URL=http://127.0.0.1:9474
IONE_ORACLE_BROWSER_TOKEN=replace-with-oracle-browser-token
IONE_ORACLE_BROWSER_TIMEOUT_SECONDS=180
IONE_ORACLE_BROWSER_MAX_TOOL_ROUNDS=5
IONE_CODEX_BIN=/opt/ione-codex-agent/runtime/node_modules/.bin/codex
IONE_CODEX_HOME=/var/lib/ione-codex-agent/codex-home
IONE_CODEX_DATA_DIR=/var/lib/ione-codex-agent/data
IONE_CODEX_WORKSPACE_ROOT=/var/lib/ione-codex-agent/workspaces
# child site uses one shared controlled work directory; permissions are still per login.
IONE_CODEX_WORKSPACE_SCOPE=site
IONE_CODEX_SANDBOX=workspace-write
IONE_CODEX_NETWORK_ACCESS=false
IONE_FRAPPE_MCP_URL=https://manager.example.com/api/method/ione_core.mcp.server.handle_mcp
# Value format: token dedicated_api_key:dedicated_api_secret
IONE_FRAPPE_AUTH_HEADER=token replace-key:replace-secret
# Same 32+ character secret as manager site config ione_agent_identity_shared_secret.
IONE_MANAGER_IDENTITY_SECRET=replace-with-a-long-random-secret
