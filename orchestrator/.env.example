IONE_ORCHESTRATOR_TOKEN=replace-with-a-long-random-token
IONE_ORCHESTRATOR_DATA_DIR=/home/zyd/services/ione-agent-orchestrator/data
IONE_MAX_CONCURRENT_RUNS=2
IONE_AGENT_MAX_ITERATIONS=12
IONE_AGENT_RUN_BUDGET_SECONDS=1800
# LibreChat calls the OpenAI-compatible bridge with this separate token.
IONE_LIBRECHAT_API_TOKEN=replace-with-a-different-long-random-token
IONE_LIBRECHAT_RUN_TIMEOUT_SECONDS=1800
# Use a dedicated Frappe integration user's API key and secret in production.
IONE_FRAPPE_BASE_URL=https://manager.myyr.top
IONE_FRAPPE_API_KEY=replace-me
IONE_FRAPPE_API_SECRET=replace-me
IONE_FRAPPE_HOST_HEADER=
IONE_FRAPPE_VERIFY_TLS=true
# Production: postgresql://ione_agent:password@127.0.0.1:5432/ione_agent
IONE_CHECKPOINT_DATABASE_URL=
QWEN_API_BASE=http://127.0.0.1:1234/v1
QWEN_API_KEY=replace-me
QWEN_MODEL=qwen3.6-35b-a3b-fp8
HERMES_API_URL=http://127.0.0.1:8642
HERMES_API_KEY=replace-me
HERMES_REQUEST_TIMEOUT_SECONDS=240
SEARXNG_URL=http://127.0.0.1:8088
DEEPSEEK_REVIEW_URL=http://127.0.0.1:9474
DEEPSEEK_REVIEW_TOKEN=replace-me
DEEPSEEK_PLANNING_TIMEOUT_SECONDS=90
DEEPSEEK_JOB_TIMEOUT_SECONDS=180
DEEPSEEK_BREAKER_FAILURES=3
DEEPSEEK_BREAKER_COOLDOWN_SECONDS=300
